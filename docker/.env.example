# =============================================================================
# 智能招聘系统 — Docker Compose 环境变量模板
# =============================================================================
# 使用方法:
#   cp docker/.env.example docker/.env
#   编辑 docker/.env，填入你的真实密钥
#
# 注意: docker/.env 已加入 .gitignore，不会提交到仓库。
# =============================================================================

# ---- 时区配置 ----
# 影响容器内日志时间、Go time.Local 以及数据库系统时区。
TZ=Asia/Shanghai

# ---- 内部通信令牌（必填） ----
# gRPC 内部认证令牌，Gateway 与后端微服务通信时使用。
# 本地开发请填入本地专用值，生产环境请生成随机字符串。
GRPC_INTERNAL_TOKEN=CHANGE_ME_GRPC_INTERNAL_TOKEN_32_CHARS

# ---- 内部 gRPC TLS（本地默认可选，生产必填） ----
# 本地 Docker 默认不挂载证书，保持 optional。
# 生产或预发环境应设置 required 并提供 CA / server cert / server key。
GRPC_INTERNAL_TLS=optional
GRPC_TLS_CA_FILE=
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_SERVER_NAME=

# ---- JWT 签名密钥 ----
# Gateway 与后端微服务必须使用相同的 JWT 密钥。
# 生产环境请使用 >= 32 字符的强随机字符串。
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS

# ---- 配置加密密钥（必填） ----
# AES-256 密钥，必须为 64 个十六进制字符；用于加密 AI/Embedding provider 凭证。
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_ENCRYPTION_KEY

# ---- AI 配置（必填） ----
# 阿里云百炼 API Key: https://bailian.console.aliyun.com/
AI_API_KEY=CHANGE_ME_AI_API_KEY
# 模型名称: qwen-plus / qwen-max / qwen-turbo 等
AI_MODEL=qwen-plus
# AI Agent 运行时: adk / legacy
AI_AGENT_RUNTIME=adk
# AI 兼容 OpenAI 协议的 Base URL。
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI 请求与工具调用调优项。
AI_TIMEOUT=90s
AI_TOTAL_TIMEOUT=120s
AI_TOOL_MAX_ROUNDS=5
AI_TOOL_TOTAL_TIMEOUT=30s
AI_MAX_CONCURRENCY=10
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_TIMEOUT=30s
AI_CIRCUIT_HALF_OPEN_MAX_REQUESTS=2
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_BASE_DELAY=500ms
AI_SLOW_RESPONSE_THRESHOLD=5s

# ---- Agent 功能开关与上下文限制 ----
AGENT_RECENT_MESSAGE_LIMIT=20
AGENT_SUMMARY_TRIGGER_MESSAGES=30
AGENT_MAX_MEMORY_CHARS=1500
AGENT_MAX_PROMPT_CHARS=20000
AGENT_MAX_MEMORIES=10
AGENT_FEATURE_PLANNER=true
AGENT_FEATURE_STRUCTURED_RESUME_PARSE=true
AGENT_FEATURE_CANDIDATE_MATCH=true
AGENT_FEATURE_CANDIDATE_MATCH_SEMANTIC=true
AGENT_FEATURE_CANDIDATE_MATCH_SHADOW=false
AGENT_FEATURE_SKILL_GOVERNANCE=true
AGENT_FEATURE_SEMANTIC_RETRIEVAL=true
AGENT_FEATURE_MCP_POLICY=true
AGENT_FEATURE_FALLBACKS=true
AGENT_RESUME_PARSE_TIMEOUT=30s
AGENT_CANDIDATE_MATCH_TIMEOUT=15s
AGENT_SEMANTIC_RETRIEVAL_TIMEOUT=5s

# ---- MCP 运行策略 ----
# MCP 服务器的具体连接信息通过后台配置和数据库保存；这里是全局安全策略。
MCP_DEFAULT_TIMEOUT_SECONDS=30
MCP_DEFAULT_MAX_RETRIES=1
MCP_ALLOW_STDIO=false
MCP_ALLOWED_STDIO_COMMANDS=npx,node
MCP_ALLOWED_URL_HOSTS=
MCP_BLOCK_PRIVATE_NETWORK=true
MCP_MAX_TIMEOUT_SECONDS=120

# ---- Embedding 召回配置 ----
# Embedding Provider 的 endpoint/api key/model 通过后台配置和数据库保存。
EMBEDDING_ENABLED=true
EMBEDDING_DEFAULT_MODEL_ID=0
EMBEDDING_FALLBACK_TO_RULE_RETRIEVAL=true
EMBEDDING_REQUEST_TIMEOUT=30s
EMBEDDING_MAX_CONCURRENCY=8
EMBEDDING_SLOW_REQUEST_THRESHOLD=2s

# ---- Ranking 召回排序权重 ----
RANKING_WEIGHT_VECTOR=0.6
RANKING_WEIGHT_LEXICAL=0.3
RANKING_WEIGHT_METADATA=0.1
RANKING_BUSINESS_BOOST_MAX=1.5
RANKING_PRIORITY_NORM=50.0
RANKING_BOOST_ALPHA=0.2
RANKING_BOOST_BETA=0.2
RANKING_BOOST_GAMMA=0.1
RANKING_RELEVANCE_GATE=0.15
RANKING_GAP_HIGH=0.10
RANKING_GAP_MEDIUM=0.03

# ---- 对象存储（必填） ----
# 用于存储候选人上传的简历文件。
# 默认使用腾讯云 COS，也可切换为阿里云 OSS。

# 存储提供商: tencent_cos / aliyun_oss
OSS_PROVIDER=tencent_cos

# ---- 腾讯云 COS 配置 ----
# 如果使用阿里云 OSS，可留空以下 COS 字段。
OSS_ENDPOINT=cos.ap-shanghai.myqcloud.com
OSS_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=CHANGE_ME_OSS_ACCESS_KEY_SECRET
OSS_BUCKET_NAME=CHANGE_ME_BUCKET_NAME
OSS_PUBLIC_BASE_URL=https://CHANGE_ME_BUCKET_NAME.cos.ap-shanghai.myqcloud.com

# ---- 阿里云 OSS 配置（可选，切换到 aliyun_oss 时使用） ----
# OSS_PROVIDER=aliyun_oss
# OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# OSS_ACCESS_KEY_ID=CHANGE_ME_ALIYUN_ACCESS_KEY_ID
# OSS_ACCESS_KEY_SECRET=CHANGE_ME_ALIYUN_ACCESS_KEY_SECRET
# OSS_BUCKET_NAME=CHANGE_ME_ALIYUN_BUCKET
# OSS_PUBLIC_BASE_URL=

# ---- CORS 跨域配置 ----
# 前端访问后端的允许来源，多个用逗号分隔。
# 本地 Docker 部署使用默认值即可。
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- Cookie 安全策略 ----
# 生产 HTTPS 环境设置为 true，本地 HTTP 环境设置为 false。
AUTH_COOKIE_SECURE=false

# ---- 登录 Cookie 名称 ----
# HR 端与候选人端必须使用不同 Cookie，避免同一 localhost 下互相覆盖登录态。
CANDIDATE_AUTH_COOKIE_NAME=recruitment_candidate_token
HR_AUTH_COOKIE_NAME=recruitment_hr_token
INTERVIEWER_AUTH_COOKIE_NAME=recruitment_interviewer_token

# ---- SMTP 邮件配置（可选） ----
# 用于发送面试邀约、Offer 等邮件通知。
# 留空 SMTP_HOST 则使用日志模式（不发送真实邮件）。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Smart Recruit

# ---- 前端基础 URL ----
# 邮件中的链接将基于此 URL 构造。
FRONTEND_BASE_URL=http://localhost:5173
