# Local application configuration and environment files.
# Example config files should use *.example.* names and remain tracked.
.env
.env.local
.env.development
.env.production
smart-recruit-commons/config/config.yaml
smart-recruit-commons/config/*.local.yaml
smart-recruit-billing-service/internal/config/config.yaml
docker/.env

# Dependency caches and installed packages.
node_modules/
.pnpm-store/
.opencode/node_modules/

# Build outputs, local binaries, and test artifacts.
dist/
bin/
*.exe
*.test
*.tsbuildinfo

# Local development stack outputs.
.dev/

# Local AI/editor/tool state that should not be shared.
.ai-guides/*
!.ai-guides/README.md
.codex/
.cursor/
.pi/
.pi-subagents/
.codegraph/
.code-review-sdd/
.security-review/
.knowledge-review/
.reasonix/
.qoder/settings.local.json

# OS/editor noise.
.DS_Store

# Local documents or binary attachments.
*.pdf

# Kubernetes manifests and certificate/private-key material containing secrets.
deploy/k8s/secret.yaml
*.pem
*.key
*.crt

# Agent harness scratch directories that are not part of the current .spec flow.
docs/agent-harness/*
!docs/agent-harness/README.md
!docs/agent-harness/00-HARNESS.md
docs/superpowers/
tools/

# Homepage design exploration artifacts; keep only the durable design contract.
homepage/.impeccable/questions/
homepage/.impeccable/sketches/
homepage/.impeccable/quality-bar/
homepage/.impeccable/mocks/
homepage/.impeccable/direction-options.json
homepage/.impeccable/direction-payload.json
homepage/.impeccable/codex-handoff.md
