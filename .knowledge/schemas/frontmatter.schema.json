{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-frontmatter.schema.json",
  "title": "Development Agent Knowledge Frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "title",
    "kind",
    "status",
    "owners",
    "tags",
    "applies_to",
    "source_refs",
    "last_verified",
    "review_after"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "architecture",
        "domain",
        "decision",
        "runbook",
        "pitfall",
        "navigation",
        "security",
        "public-contract",
        "candidate"
      ]
    },
    "status": { "enum": ["draft", "active", "stale", "deprecated", "archived"] },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "review_after": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "decision_status": { "enum": ["proposed", "accepted", "rejected", "superseded"] },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^adr-[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "superseded_by": {
      "type": ["string", "null"],
      "pattern": "^adr-[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "candidate" } }, "required": ["kind"] },
      "then": { "properties": { "status": { "const": "draft" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "decision" } }, "required": ["kind"] },
      "then": { "required": ["decision_status", "supersedes", "superseded_by"] }
    }
  ]
}
